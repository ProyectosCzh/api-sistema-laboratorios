generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ENCARGADO
  AYUDANTE
}

enum ClassroomType {
  LAB_COMPUTACION
  LAB_GENERAL
  AULA
}

enum ClassroomStatus {
  ACTIVA
  INACTIVA
  EN_MANTENIMIENTO
  FUERA_SERVICIO
}

enum CourseOfferingType {
  CLASE
  EXTRACURRICULAR
  ACTIVIDAD
}

enum MaintenanceStatus {
  REPORTADO
  EN_PROGRESO
  COMPLETADO
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole        @default(AYUDANTE)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  schedules    Schedule[]
  annotations  Annotation[]
  maintenance  MaintenanceLog[]
}

model Classroom {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  type        ClassroomType
  capacity    Int?
  location    String?
  status      ClassroomStatus  @default(ACTIVA)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  schedules   Schedule[]
  annotations Annotation[]
  maintenance MaintenanceLog[]
}

model TimeSlot {
  id        String     @id @default(cuid())
  label     String
  startTime String
  endTime   String
  order     Int        @unique
  schedules Schedule[]
}

model Semester {
  id            String     @id @default(cuid())
  name          String     @unique
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean    @default(false)
  schedules     Schedule[]
  offerings     CourseOffering[]

  @@index([isActive])
}

model Teacher {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  email          String?          @unique
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  offerings      CourseOffering[]
}

model Subject {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  offerings      CourseOffering[]
}

model CourseOffering {
  id         String             @id @default(cuid())
  semesterId String
  subjectId  String
  teacherId  String?
  section    String
  type       CourseOfferingType @default(CLASE)
  active     Boolean            @default(true)
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  semester  Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])
  schedules Schedule[]

  @@unique([semesterId, subjectId, section, teacherId])
  @@index([semesterId])
  @@index([subjectId])
  @@index([teacherId])
}

model Schedule {
  id               String   @id @default(cuid())
  classroomId      String
  semesterId       String
  courseOfferingId String
  dayOfWeek        Int
  timeSlotId       String
  note             String?
  assignedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  classroom      Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  semester       Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  timeSlot       TimeSlot       @relation(fields: [timeSlotId], references: [id])
  assignedBy     User           @relation(fields: [assignedById], references: [id])

  @@unique([classroomId, semesterId, dayOfWeek, timeSlotId])
  @@unique([courseOfferingId, dayOfWeek, timeSlotId])
  @@index([classroomId, semesterId])
  @@index([courseOfferingId])
}

model Annotation {
  id          String    @id @default(cuid())
  classroomId String
  userId      String
  date        DateTime  @default(now())
  content     String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

model MaintenanceLog {
  id          String            @id @default(cuid())
  classroomId String
  date        DateTime
  reason      String
  status      MaintenanceStatus @default(REPORTADO)
  createdById String
  createdAt   DateTime          @default(now())
  classroom   Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User              @relation(fields: [createdById], references: [id])

  @@index([classroomId, status])
}
