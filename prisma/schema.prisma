generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ENCARGADO
  AYUDANTE
}

enum ClassroomType {
  LAB_COMPUTACION
  LAB_GENERAL
  AULA
}

enum ClassroomStatus {
  ACTIVA
  INACTIVA
  EN_MANTENIMIENTO
  FUERA_SERVICIO
}

enum MaintenanceStatus {
  REPORTADO
  EN_PROGRESO
  COMPLETADO
}

enum ReservationType {
  RECURRENTE
  PUNTUAL
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         UserRole         @default(AYUDANTE)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  schedules    Schedule[]
  annotations  Annotation[]
  maintenance  MaintenanceLog[]
  requestedReservations Reservation[] @relation("ReservationRequester")
  resolvedReservations  Reservation[] @relation("ReservationResolver")
}

model Classroom {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  type        ClassroomType
  capacity    Int?
  location    String?
  status      ClassroomStatus  @default(ACTIVA)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  schedules   Schedule[]
  annotations Annotation[]
  maintenance MaintenanceLog[]
  reservations Reservation[]
}

model TimeSlot {
  id        String        @id @default(cuid())
  label     String
  startTime String
  endTime   String
  order     Int           @unique
  schedules Schedule[]
  reservations Reservation[]
}

model Semester {
  id            String        @id @default(cuid())
  name          String        @unique
  startDate     DateTime
  endDate       DateTime
  workingDays   Int[]         @default([1, 2, 3, 4, 5, 6])
  isActive      Boolean       @default(false)
  schedules     Schedule[]
  reservations  Reservation[]

  @@index([isActive])
}

model Teacher {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  email          String?          @unique
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  schedules      Schedule[]
}

model Subject {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  schedules      Schedule[]
}

/// Bloque academico de la planilla semanal: una materia (con docente opcional)
/// ocupa un aula en un dia y turno durante todo el semestre.
model Schedule {
  id            String   @id @default(cuid())
  classroomId   String
  semesterId    String
  subjectId     String
  teacherId     String?
  dayOfWeek     Int
  timeSlotId    String
  note          String?
  assignedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classroom  Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  semester   Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject    Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher    Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timeSlot   TimeSlot  @relation(fields: [timeSlotId], references: [id])
  assignedBy User      @relation(fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([classroomId, semesterId, dayOfWeek, timeSlotId])
  @@index([semesterId])
  @@index([subjectId])
  @@index([teacherId])
}

/// Reserva operativa registrada por el personal.
/// RECURRENTE: ocupa la celda dayOfWeek + turno durante todo el semestre.
/// PUNTUAL: ocupa solo la fecha indicada (date) en el turno indicado.
model Reservation {
  id            String            @id @default(cuid())
  classroomId   String
  semesterId    String
  type          ReservationType
  dayOfWeek     Int?
  date          DateTime?
  timeSlotId    String
  status        ReservationStatus @default(PENDIENTE)
  note          String?
  requestedById String
  resolvedById  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  semester    Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  timeSlot    TimeSlot  @relation(fields: [timeSlotId], references: [id])
  requestedBy User      @relation("ReservationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy  User?     @relation("ReservationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([classroomId, semesterId, status])
  @@index([semesterId])
  @@index([requestedById])
  @@index([status])
}

model Annotation {
  id          String    @id @default(cuid())
  classroomId String
  userId      String
  date        DateTime  @default(now())
  content     String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([classroomId, date])
}

model MaintenanceLog {
  id          String            @id @default(cuid())
  classroomId String
  date        DateTime
  reason      String
  status      MaintenanceStatus @default(REPORTADO)
  createdById String
  createdAt   DateTime          @default(now())
  classroom   Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdBy   User              @relation(fields: [createdById], references: [id])

  @@index([classroomId, status])
}
