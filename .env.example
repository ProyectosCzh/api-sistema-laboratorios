# ============================================
# LABMANAGE API - Variables de entorno
# Copia este archivo como .env y completa los valores reales
# ============================================

# --- Conexión a PostgreSQL (Neon) ---
# Obtenla en: https://neon.tech -> tu proyecto -> Connect -> Connection string
# Formato: postgresql://USUARIO:PASSWORD@HOST-NEON.aws.neon.tech/NOMBRE_BD?sslmode=require
# Usa la conexion DIRECTA (no la pooled) para Prisma.
DATABASE_URL="postgresql://tu_usuario:tu_password@ep-xxxx.region.aws.neon.tech/labmanage?sslmode=require"

# --- Seguridad ---
# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET="cambiar-por-un-secreto-largo-aleatorio"

# Expiración del JWT legacy (formato vercel/ms, ej: 12h). Solo tokens viejos.
JWT_EXPIRES_IN="12h"

# TTL del access token de sesión (formato vercel/ms). Default: 15m
ACCESS_TOKEN_TTL="15m"

# Días de vida del refresh token / Session. Default: 7
REFRESH_TOKEN_TTL_DAYS=7

# Cookies Secure (true solo detrás de HTTPS/reverse proxy). Default: false
COOKIE_SECURE=false

# Confiar en X-Forwarded-* (true solo detrás de reverse proxy). Default: false
TRUST_PROXY=false

# Desactivar docs Scalar/OpenAPI en producción con DOCS_ENABLED=false. Default: true
DOCS_ENABLED=true

# --- Servidor ---
# Puerto donde corre la API
PORT=3001

# Entorno: development | production (afecta logs, CSP, etc.)
NODE_ENV=development

# --- CORS ---
# Origen permitido del frontend (separar varios con comas). En producción: la URL del front desplegado.
CORS_ORIGIN=http://localhost:4321

# Si está seteado, restringe CORS a este origen (URL del BFF Astro). Vacío = usa CORS_ORIGIN.
WEB_ORIGIN=
