# ============================================
# LABMANAGE API - .gitignore
# Solo se sube lo necesario a GitHub.
# Mantiene versionado: .env.example, prisma/,
# src/, tests/, package.json, tsconfig.json, etc.
# ============================================

# --- Dependencias ---
node_modules/

# --- Variables de entorno (secretos) ---
.env
.env.local
.env.*.local

# --- Build ---
dist/
build/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Prisma (generado) ---
/generated/prisma

# --- Testing / cobertura ---
coverage/

# --- Editor / SO ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Herramientas de IA (config local, no parte de la app) ---
.agents/
.claude/
.windsurf/